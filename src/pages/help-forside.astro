
---
import Footer from "../components/footer.astro";
import Header from "../components/nav.astro";
import Button from "../components/knapper.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>About</title>
  </head>

  <body>
    <Header />

    <main>

      <!-- Join the community -->
      <section class="community-section content-width">

        <div class="community-copy">
          <h2>Join the community</h2>
          <p>
            Good ideas starts with a great conversation! At KindDesign we bring
            creative people together to share ideas, find inspiration and make new
            connections. Come for the inspiration, stay for the connections.
            Meet like-minded creatives, exchange ideas and become part of a
            community that shares your passion for design.
          </p>

          <Button text="Explore events" href="/events" />
        </div>

        <div class="community-box">
          <img
            src="/images/community.jpg"
            alt="Creative people connecting at a KindDesign event"
            class="community-image"
          />

          <span class="community-circle" aria-hidden="true"></span>
        </div>

      </section>


      <!-- Who are we? -->
      <section class="who-section content-width">

        <div class="who-copy">
          <h2>Who are we?</h2>
          <p>
            KindDesign was founded by Julia and Jeremy, who shared an interest
            in design and creativity. Inspired by Julia's solo trip to Lisbon,
            where she experienced the need for a space to meet like-minded
            creatives, they created a community in Copenhagen where people can
            connect, share ideas and inspire one another.
          </p>
        </div>

        <div class="who-box">
          <img
            src="/images/who-are-we.jpg"
            alt="The founders of KindDesign talking at an event"
            class="who-image"
          />

          <span class="who-circle" aria-hidden="true"></span>
        </div>

      </section>


      <!-- Contact CTA -->
      <section class="contact-cta" aria-labelledby="cta-title">

        <div class="cta-copy">
          <h2 id="cta-title">Let's create something together.</h2>

          <p>
            KindDesign is built around creative people, shared ideas and meaningful
            connections. We are always looking to connect with designers, creatives
            and partners who want to bring people together and contribute to our
            community.
          </p>

          <p>
            Whether you have knowledge to share, an idea for an event or a space
            to host one, we'd love to hear from you.
          </p>

          <Button
            text="Get in touch"
            href="mailto:kinddesign.cph@gmail.com"
          />
        </div>

      </section>

    </main>

    <Footer />
  </body>
</html>


<style>
  :root {
    --brown: #280d10;
    --yellow: #ffff9a;
    --text: #080808;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--text);
    background: #fff;
    font-family: "Helvetica";
    font-size: 20px;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  a {
    color: inherit;
  }

  /* Shared content width */
  .content-width,
  .contact-cta {
    width: calc(100% - 80px);
    max-width: 1100px;
    margin-inline: auto;
  }


  /* Join the community */
  .community-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 539px;
    gap: 40px;
    align-items: center;
    margin-top: 80px;
  }

  .community-copy h2,
  .who-copy h2 {
    margin: 0 0 19px;
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.7px;
  }

  .community-copy p,
  .who-copy p {
    margin: 0 0 25px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: lighter;
  }

  .community-box {
    width: 100%;
    height: 559px;
    background: var(--yellow);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }

  .community-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .community-circle {
    position: absolute;
    width: 100px;
    height: 100px;
    background: var(--brown);
    border-radius: 50%;
    right: 20px;
    bottom: 20px;
  }


  /* Who are we? */
  .who-section {
    display: grid;
    grid-template-columns: 539px minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    margin-top: 80px;
  }

  .who-copy {
    grid-column: 2;
    grid-row: 1;
  }

  .who-box {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 559px;
    background: var(--brown);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }

  .who-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .who-circle {
    position: absolute;
    width: 100px;
    height: 100px;
    background: var(--yellow);
    border-radius: 50%;
    right: 20px;
    bottom: 20px;
  }


  /* Contact CTA */
  .contact-cta {
    margin-top: 78px;
    margin-bottom: 80px;
    padding: 35px 45px;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    background: var(--yellow);
    border-radius: 12px;
  }

  .cta-copy {
    max-width: 750px;
  }

  .contact-cta h2 {
    margin: 0 0 20px;
    color: var(--brown);
    font-size: 36px;
    line-height: 1.27;
    letter-spacing: -0.6px;
  }

  .cta-copy p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.35;
    font-weight: lighter;
  }


  /* Mobile */
  @media (max-width: 600px) {

    .content-width,
    .contact-cta {
      width: calc(100% - 32px);
    }

    .community-section,
    .who-section {
      display: block;
      margin-top: 60px;
    }

    /* Put text and image inside the colored boxes */
    .community-copy,
    .who-copy {
      padding: 30px 24px 20px;
    }

    .community-box,
    .who-box {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 0;
      border-radius: 12px;
    }

    .community-box {
      background: var(--yellow);
    }

    .who-box {
      background: var(--brown);
    }

    /* Text colors */
    .community-copy h2 {
      color: var(--brown);
      font-size: 25px;
    }

    .community-copy p {
      color: var(--brown);
      font-size: 14px;
    }

    .who-copy h2,
    .who-copy p {
      color: var(--yellow);
    }

    .who-copy h2 {
      font-size: 25px;
    }

    .who-copy p {
      font-size: 14px;
    }

    /* Images inside boxes */
    .community-image,
    .who-image {
      width: calc(100% - 48px);
      height: 190px;
      margin: 0 24px 30px;
      border-radius: 8px;
      object-fit: cover;
    }

    /* Circles */
    .community-circle,
    .who-circle {
      width: 65px;
      height: 65px;
      right: 15px;
      bottom: 15px;
    }

    /* Contact CTA */
    .contact-cta {
      margin-top: 60px;
      margin-bottom: 60px;
      padding: 25px 20px;
    }

    .contact-cta h2 {
      font-size: 24px;
    }

    .cta-copy p {
      font-size: 13px;
    }
  }
</style>
