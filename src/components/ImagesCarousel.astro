<style>
  .carousel {
    position: relative;
    width: 100%;
    height: 550px;
    overflow: hidden;
    background-color: white;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80%;
    height: 90%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .slide.active {
    opacity: 1;
    z-index: 2;
  }

  .slide.previous {
    opacity: 1;
    z-index: 1;
  }

/* Desktop er skjult på mobil */
.desktop-carousel {
  display: none;
}

@media (min-width: 900px) {

  /* Skjul mobilkarrusellen */
  .carousel {
    display: none;
  }


.desktop-carousel {
  display: block;
  width: 100%;
  overflow: hidden;
  padding: 10px 0 40px;
  box-sizing: border-box;
}

.desktop-track {
  display: flex;
  align-items: flex-end;
  gap: 25px;
  width: max-content;
  height: 350px;
  animation: moveCarousel 35s linear infinite;
}

.desktop-track img {
  width: 150px;
  height: 230px;
  object-fit: cover;
  flex-shrink: 0;
  cursor: pointer;
  transition: width 0.4s ease, height 0.4s ease;
}

.desktop-track img:hover {
  width: 260px;
  height: 350px;
  object-fit: contain;
}

  /* Stop bevægelsen ved hover */
  .desktop-track:hover {
    animation-play-state: paused;
  }

  /* Bevægelse fra venstre mod højre */
  @keyframes moveCarousel {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .desktop-track {
    animation: none;
  }
}
</style>


<script>
  const slides = document.querySelectorAll(".slide");

  let currentSlide = 1;

  function changeSlide() {
    let oldSlide = currentSlide;

    currentSlide++;

    if (currentSlide >= slides.length) {
      currentSlide = 0;
    }

    slides[oldSlide].classList.remove("active");
    slides[oldSlide].classList.add("previous");

    slides[currentSlide].classList.add("active");

    setTimeout(() => {
      slides[oldSlide].classList.remove("previous");
    }, 600);
  }

  setInterval(changeSlide, 3000);
</script>