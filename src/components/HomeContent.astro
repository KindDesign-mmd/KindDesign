---
import Knapper from '../components/knapper.astro'
---

<section class="home-content">
  <h1 class="home-title">
    Creative community for<br /> all kinds of designers,<br /> meetups & events
  </h1>

  <!-- JOIN THE COMMUNITY -->
  <section class="home-card community-card">
    <div class="home-text">
      <h2>Join the community</h2>

      <p>
        Good ideas start with a great conversation!
        At KindDesign we bring creative people together
        to share ideas, find inspiration and make new
        connections. Come for the inspiration, stay for
        the connections. Meet like-minded creatives,
        exchange ideas and become part of a community
        that shares your passion for design.
      </p>

      <Knapper text="Explore events" href="/events" />
    </div>

    <div class="home-image-wrapper">
      <img
        src="/images/Community-1.webp"
        alt="Creative community event"
      />
      <span class="decoration-circle"></span>
    </div>
  </section>

  <!-- ABOUT US -->
  <section class="home-card about-card">
    <div class="home-text">
      <h2>About us</h2>

      <p>
        Kinddesign was founded by Julia and Jeremy,
        who met during their studies. Together, they
        wanted to create a creative community in
        Copenhagen where designers and creatives could
        connect, share ideas, and find inspiration.
      </p>

          <Knapper text="Read more" href="/about" />
 
    </div>

    <div class="home-image-wrapper">
      <img
        src="/images/who-are-we.jpg"
        alt="The founders of Kind Design"
      />
      <span class="decoration-circle"></span>
    </div>
  </section>

  <!-- GET IN TOUCH -->
  <section class="home-card contact-card">
    <span class="top-circle"></span>

    <h2>
      Let's create something together.
    </h2>

    <p>
      KindDesign is built around creative people,
      shared ideas and meaningful connections.
      We are always looking to connect with
      designers, creatives and partners who want
      to bring people together and contribute
      to our community.
    </p>

    <p>
      Whether you have knowledge to share,
      an idea for an event or a space to host
      one, we'd love to hear from you.
    </p>

    <Knapper text="Get in touch" href="/about" />

  </section>
</section>

<style>
  .home-content {
    padding: 0 16px;
    font-family: Arial, sans-serif;
  }

  .home-title {
    text-align: center;
    font-size: clamp(28px, 7.5vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    margin: 35px auto 55px;
    color: black;
  }

  /* FÆLLES STYLING */

  .home-card {
    position: relative;
    border-radius: 34px;
    padding: 70px 35px 90px;
    margin-bottom: 45px;
    text-align: center;
  }

  .home-card h2 {
    font-size: clamp(30px, 8vw, 44px);
    line-height: 1.2;
    margin: 0 0 35px;
    font-weight: 700;
  }

  .home-card p {
    font-size: clamp(17px, 4.2vw, 22px);
    line-height: 1.2;
    font-weight: 400;
    max-width: 410px;
    margin: 0 auto 35px;
  }

  /* FARVER */

  .community-card,
  .contact-card {
    background-color: #ffffad;
    color: #27090e;
  }

  .about-card {
    background-color: #27090e;
    color: #ffffad;
  }

  .about-card p {
    color: white;
    text-align: left;
  }

  /* KNAPPER */

  .home-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    padding: 13px 27px;
    background-color: #27090e;
    color: white;
    border-radius: 100px;
    font-size: 20px;
    text-decoration: none;
    margin: 40px auto 70px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .home-button:hover {
    opacity: 0.8;
  }

  .button-circle {
    display: block;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: white;
    flex-shrink: 0;
  }

  .about-card .home-button {
    background-color: #ffffad;
    color: #27090e;
  }

  .about-card .button-circle {
    background-color: #27090e;
  }

  /* BILLEDER */

  .home-image-wrapper {
    position: relative;
    width: 85%;
    max-width: 335px;
    margin: 0 auto;
    padding-top: 1.5rem;
  }

  .home-image-wrapper img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.2);
  }

  /* DEKORATIVE CIRKLER */

  .decoration-circle {
    position: absolute;
    width: 115px;
    height: 115px;
    border-radius: 50%;
    background-color: #27090e;
    right: -65px;
    bottom: -65px;
  }

  .about-card .decoration-circle {
    background-color: #ffffad;
    right: auto;
    left: -65px;
  }

  /* CONTACT */

  .contact-card {
    padding-top: 65px;
    padding-bottom: 55px;
  }

  .contact-card h2 {
    margin-bottom: 40px;
  }

  .contact-card p {
    margin-bottom: 30px;
  }

  .contact-card .home-button {
    margin-top: 15px;
    margin-bottom: 0;
  }

  .top-circle {
    position: absolute;
    top: 28px;
    left: 15px;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background-color: #27090e;
  }



@media (min-width: 900px) {

  /* INDHOLDSOMRÅDE */

  .home-content {
    box-sizing: border-box;
    width: 80%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0 110px;
    border-left: 1px solid #aaa;
  }

  /* OVERSKRIFT */

  .home-title {
    max-width: 850px;
    margin: 70px auto 130px;
    padding: 0 20px;
    font-size: 38px;
    line-height: 1.2;
    font-weight: 700;
    text-align: center;
    color: #27090e;
  }

  .home-title br {
    display: none;
  }

  /* FÆLLES SEKTIONER */

  .home-card {
    box-sizing: border-box;
    position: relative;
    margin: 0;
    padding: 25px 22px;
    border-radius: 0;
    border-top: 1px solid #aaa;
    background: transparent;
    color: #27090e;
    text-align: left;
  }

  .home-card h2 {
    font-size: 36px;
    line-height: 1.15;
    margin: 0 0 25px;
    color: #27090e;
  }

  .home-card p {
    max-width: none;
    font-size: 16px;
    line-height: 1.3;
    margin: 0 0 18px;
    color: #27090e;
  }

  .home-text {
    min-width: 0;
  }

  /* KNAPPER */

  .home-button {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 9px 18px;
    margin: 0;
    gap: 10px;
    font-size: 15px;
  }

  .button-circle {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* JOIN THE COMMUNITY */

  .community-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    min-height: 530px;
    align-items: stretch;
  }

  .community-card .home-text {
    grid-column: 1;
    grid-row: 1;
    padding-right: 22px;
  }

  .community-card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: #aaa;
  }

  .community-card .home-image-wrapper {
    box-sizing: border-box;
    grid-column: 2;
    grid-row: 1;
    position: relative;
    width: 100%;
    max-width: none;
    height: 480px;
    margin: 0;
    border-radius: 18px;
    background: #ffffad;
  }

  .community-card .home-image-wrapper img {
    display: none;
  }

  .community-card .decoration-circle {
    width: 65px;
    height: 65px;
    right: 25px;
    bottom: 25px;
  }

  /* ABOUT US */

  .about-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    min-height: 630px;
    align-items: start;
  }

  .about-card .home-text {
    grid-column: 2;
    grid-row: 1;
  }

  .about-card .home-button {
    background: #ffffad;
    color: #27090e;
  }

  .about-card .home-image-wrapper {
    box-sizing: border-box;
    grid-column: 1;
    grid-row: 1;
    position: relative;
    width: 100%;
    max-width: none;
    height: 580px;
    margin: 0;
    background: #27090e;
    border-radius: 18px;
  }

.about-card .home-image-wrapper img {
  position: absolute;
  width: 45%;
  height: 320px;
  object-fit: cover;
  left: auto;
  right: calc(-100% - 24px);
  bottom: 0;
  border-radius: 14px;
}

  .about-card .decoration-circle {
    width: 105px;
    height: 105px;
    left: 25px;
    bottom: 25px;
  }

  /* LET'S CREATE SOMETHING TOGETHER */

  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 65px 35px 90px;
    border-top: 1px solid #aaa;
    text-align: center;
    isolation: isolate;
  }

  .contact-card::before {
    content: "";
    position: absolute;
    inset: 25px 22px 0;
    background: #ffffad;
    border-radius: 18px;
    z-index: -1;
  }

  .contact-card h2 {
    font-size: 36px;
    line-height: 1.15;
    margin: 0 0 30px;
  }

  .contact-card h2 br {
    display: none;
  }

  .contact-card p {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.3;
    margin-bottom: 20px;
    text-align: center;
  }

  .contact-card .top-circle {
    width: 42px;
    height: 42px;
    top: 45px;
    left: 45px;
  }

  .contact-card .home-button {
    margin: 25px auto 0;
  }

}




</style>
